---
import type { CollectionEntry } from "astro:content";
import { commentConfig } from "@/config/commentConfig";
import { i18n } from "@/i18n/translation";
import Key from "@/i18n/i18nKey";
import Waline from "./Waline.astro";

interface Props {
  post: CollectionEntry<"posts"> | CollectionEntry<"spec">;
  customPath?: string;
}

const { post, customPath } = Astro.props;
const { id, data, slug } = post;

const path =
  customPath || (post.collection === "posts" ? `/posts/${slug}` : `/${slug}`);
const url = `${Astro.site?.href}${path}`;

let commentService = "";
if (commentConfig?.enable && commentConfig?.waline) {
  commentService = "waline";
}
---

{
  commentConfig?.enable && (
    <div class="card-base p-8 mb-6 relative overflow-hidden group">
      <div class="absolute inset-0 bg-gradient-to-br from-[var(--primary)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
      
      <div class="relative z-10 mb-8 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="w-1.5 h-8 bg-gradient-to-b from-[var(--primary)] to-[var(--primary)]/30 rounded-full shadow-[0_0_10px_var(--primary)]"></div>
          <div>
            <h3 class="text-2xl font-bold text-[var(--btn-content)] i18n-label tracking-tight" data-i18n-key={Key.commentSection}>{i18n(Key.commentSection)}</h3>
            <p class="text-sm text-[var(--content-meta)] mt-1 i18n-label" data-i18n-key={Key.commentSubtitle}>{i18n(Key.commentSubtitle)}</p>
          </div>
        </div>
        <div class="hidden sm:flex w-10 h-10 rounded-full bg-[var(--primary)]/10 items-center justify-center text-[var(--primary)] shadow-sm transition-transform duration-300 group-hover:scale-110">
           <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>
        </div>
      </div>
      
      
      <div class="relative z-10">
        {commentService === "waline" && <Waline path={path} />}
        {commentService === "" && (
          <div class="text-center py-8 text-[var(--content-meta)]">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-[var(--btn-regular-bg)] flex items-center justify-center">
              <svg class="w-8 h-8 text-[var(--primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
              </svg>
            </div>
            <p class="i18n-label" data-i18n-key={Key.commentNotConfigured}>{i18n(Key.commentNotConfigured)}</p>
          </div>
        )}
      </div>
    </div>
  )
}
