---
import path from "node:path";
import Comment from "@components/comment/index.astro";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import PostMetadata from "@/components/content/PostMeta.astro";
import AudioPlayer from "@/components/misc/AudioPlayer.astro";
import ImageWrapper from "@/components/misc/ImageWrapper.astro";
import { licenseConfig } from "@/config/licenseConfig";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const { remarkPluginFrontmatter } = await entry.render();

// ...existing code...

dayjs.extend(utc);
const siteUrl = Astro.site
	? Astro.site.toString()
	: "https://shishir-pandey.com.np/";
const postUrl = new URL(getPostUrlBySlug(entry.slug), siteUrl).toString();

const coverImageUrl = entry.data.image
	? entry.data.image.startsWith("http://") ||
		entry.data.image.startsWith("https://")
		? entry.data.image
		: new URL(entry.data.image, siteUrl).toString()
	: undefined;

const postJsonLd = {
	"@context": "https://schema.org",
	"@type": ["BlogPosting", "TechArticle"],
	"@id": `${postUrl}#article`,
	isPartOf: {
		"@type": "WebSite",
		"@id": `${siteUrl}#website`,
		name: siteConfig.title,
		url: siteUrl,
	},
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	url: postUrl,
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": postUrl,
	},
	image: coverImageUrl ? [coverImageUrl] : undefined,
	datePublished: dayjs(entry.data.published).toISOString(),
	dateModified: dayjs(entry.data.updated || entry.data.published).toISOString(),
	author: {
		"@type": "Person",
		name: entry.data.author || profileConfig.name,
		url: siteUrl,
		sameAs: [
			"https://github.com/shishir0x",
			"https://instagram.com/shishir0x",
			"https://www.youtube.com/@shishir0_x",
		],
	},
	publisher: {
		"@type": "Person",
		name: profileConfig.name,
		url: siteUrl,
		logo: {
			"@type": "ImageObject",
			url: new URL("/favicon-white.ico", siteUrl).toString(),
		},
	},
	keywords:
		entry.data.tags && entry.data.tags.length > 0
			? entry.data.tags.join(", ")
			: undefined,
	articleSection: entry.data.category || "Projects",
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	wordCount: remarkPluginFrontmatter?.words || undefined,
	...(entry.data.sourceLink
		? {
				about: {
					"@type": "SoftwareApplication",
					name: "Telegram Unlimited Drive (TG Drive)",
					applicationCategory: "UtilitiesApplication",
					operatingSystem: "Cross-platform",
					codeRepository: entry.data.sourceLink,
					offers: {
						"@type": "Offer",
						price: "0",
						priceCurrency: "USD",
					},
				},
			}
		: {}),
};

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Home",
			item: siteUrl,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Archive",
			item: new URL("/archive/", siteUrl).toString(),
		},
		{
			"@type": "ListItem",
			position: 3,
			name: entry.data.title,
			item: postUrl,
		},
	],
};
---

<MainGridLayout
  banner={entry.data.image}
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.slug}
  headings={headings}
  publishedDate={entry.data.published}
  updatedDate={entry.data.updated || entry.data.published}
  author={entry.data.author || profileConfig.name}
  tags={entry.data.tags}
  category={entry.data.category || undefined}
  jsonLd={[postJsonLd, breadcrumbJsonLd]}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(postJsonLd)}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />
  <div
    class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4"
  >
    <div
      id="post-container"
      class:list={[
        "card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
        {},
      ]}
    >
      <!-- word count and reading time -->
      <div
        class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation"
      >
        <div class="flex flex-row items-center">
          <div
            class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
          >
            <Icon name="material-symbols:notes-rounded" />
          </div>
          <div class="text-sm">
            {remarkPluginFrontmatter.words}
            <span
              class="i18n-label"
              data-i18n-key={remarkPluginFrontmatter.words === 1
                ? I18nKey.wordCount
                : I18nKey.wordsCount}
            >
              {
                " " +
                  i18n(
                    remarkPluginFrontmatter.words === 1
                      ? I18nKey.wordCount
                      : I18nKey.wordsCount,
                  )
              }
            </span>
          </div>
        </div>
        <div class="flex flex-row items-center">
          <div
            class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
          >
            <Icon name="material-symbols:schedule-outline-rounded" />
          </div>
          <div class="text-sm">
            {remarkPluginFrontmatter.minutes}
            <span
              class="i18n-label"
              data-i18n-key={remarkPluginFrontmatter.minutes === 1
                ? I18nKey.minuteCount
                : I18nKey.minutesCount}
            >
              {
                " " +
                  i18n(
                    remarkPluginFrontmatter.minutes === 1
                      ? I18nKey.minuteCount
                      : I18nKey.minutesCount,
                  )
              }
            </span>
          </div>
        </div>
      </div>

      <!-- title -->
      <div class="relative onload-animation">
        <h1
          data-pagefind-body
          data-pagefind-weight="10"
          data-pagefind-meta="title"
          class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]"
        >
          {entry.data.title}
        </h1>
      </div>

      <!-- metadata -->
      <div class="onload-animation">
        <PostMetadata
          className="mb-5"
          published={entry.data.published}
          updated={entry.data.updated}
          tags={entry.data.tags}
          category={entry.data.category}
          slug={entry.slug}
        />
        {
          !entry.data.image && (
            <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mt-3 mb-5" />
          )
        }
      </div>

      <!-- always show cover as long as it has one -->

      {
        entry.data.image && (
          <div style="margin-top:1rem;">
            <ImageWrapper
              id="post-cover"
              src={entry.data.image}
              basePath={path.join("content/posts/", getDir(entry.id))}
              class="mb-8 rounded-xl banner-container onload-animation"
            />
          </div>
        )
      }

      <!-- podcast audio player -->
      {
        entry.data.audio && (
          <AudioPlayer src={entry.data.audio} title={entry.data.title} />
        )
      }

      <Markdown class="mb-6 markdown-content onload-animation">
        <Content />
      </Markdown>
      {
        licenseConfig.enable && (
          <License
            title={entry.data.title}
            slug={entry.slug}
            pubDate={entry.data.published}
            author={entry.data.author}
            sourceLink={entry.data.sourceLink}
            licenseName={entry.data.licenseName}
            licenseUrl={entry.data.licenseUrl}
            class="mb-6 rounded-xl license-container onload-animation"
          />
        )
      }
    </div>
  </div>

  {
    siteConfig.showLastModified && (
      <div class="card-base p-6 mb-4">
        <div class="card-base p-1 mb-0.1">
          <div class="flex items-center gap-2">
            <div class="transition h-9 w-9 rounded-lg overflow-hidden relative flex items-center justify-center mr-0">
              <Icon
                name="material-symbols:history-rounded"
                class="text-4xl text-[var(--primary)] transition-transform group-hover:translate-x-0.5 bg-[var(--enter-btn-bg)] p-2 rounded-md"
              />
            </div>

            {(() => {
              const lastModified = dayjs(
                entry.data.updated || entry.data.published,
              );
              const now = dayjs();
              const daysDiff = now.diff(lastModified, "day");
              const dateStr = lastModified.format("YYYY-MM-DD");
              const isOutdated = daysDiff >= 1;

              return (
                <div class="flex flex-col gap-0.1">
                  <div class="text-[1.0rem] leading-tight text-black/75 dark:text-white/75">
                    <span
                      class="i18n-label"
                      data-i18n-key={I18nKey.lastModifiedPrefix}
                    >
                      {i18n(I18nKey.lastModifiedPrefix)}
                    </span>
                    {dateStr}
                    {isOutdated && (
                      <>
                        <span>，</span>
                        <span
                          class="i18n-label"
                          data-i18n-key={I18nKey.lastModifiedDaysAgo}
                          data-i18n-days={daysDiff.toString()}
                        >
                          {i18n(I18nKey.lastModifiedDaysAgo).replace(
                            "{days}",
                            daysDiff.toString(),
                          )}
                        </span>
                      </>
                    )}
                  </div>
                  {isOutdated && (
                    <p
                      class="text-[0.8rem] leading-tight text-black/75 dark:text-white/75 i18n-label"
                      data-i18n-key={I18nKey.lastModifiedOutdated}
                    >
                      {i18n(I18nKey.lastModifiedOutdated)}
                    </p>
                  )}
                </div>
              );
            })()}
          </div>
        </div>
      </div>
    )
  }

  <Comment post={entry} />

  <div
    class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full"
  >
    <a
      href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
      class:list={[
        "w-full font-bold overflow-hidden active:scale-95",
        { "pointer-events-none": !entry.data.nextSlug },
      ]}
    >
      {
        entry.data.nextSlug && (
          <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4">
            <Icon
              name="material-symbols:chevron-left-rounded"
              class="text-[2rem] text-[var(--primary)]"
            />
            <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
              {entry.data.nextTitle}
            </div>
          </div>
        )
      }
    </a>

    <a
      href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
      class:list={[
        "w-full font-bold overflow-hidden active:scale-95",
        { "pointer-events-none": !entry.data.prevSlug },
      ]}
    >
      {
        entry.data.prevSlug && (
          <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
            <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
              {entry.data.prevTitle}
            </div>
            <Icon
              name="material-symbols:chevron-right-rounded"
              class="text-[2rem] text-[var(--primary)]"
            />
          </div>
        )
      }
    </a>
  </div>
</MainGridLayout>
